# The kids' Spotify playlists to Navidrome, and from there to their Cardputers (wolfpack-sync.py).
[Unit]
Description=Wolfpack: kids' Spotify playlists to Navidrome
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/Work/cardputer-adv-supachat/tools/sd-cards/wolfpack-sync.py
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
TimeoutStartSec=2h
